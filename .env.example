# Server Port
PORT=3000

# --- Proxmox Provider Credentials ---
# Note the corrected variable names and endpoint format
PROXMOX_ENDPOINT=https://<proxmox-endpoint>:8006
PROXMOX_API_TOKEN_ID=root@pam!<token-name>
PROXMOX_API_TOKEN_SECRET=<token-secret>

# --- Project-specific settings for Pulumi program ---
PROXMOX_NODE=<node-name>
PROXMOX_TEMPLATE_VM_ID=9000
PROXMOX_DATASTORE_ID=<datastore>

PROXMOX_SSL_VERIFY=false # or true depending on ssl/tls cert

NODE_ENV=development # development or production
LOG_LEVEL=debug

DATABASE_URL=prisma+postgres://localhost:51213/?api__c3NsbW9kZT1kaXNhYmxlJmNvbm5lY3Rpb25fbGltaXQ9MSZjb25uZWN0X3RpbWVvdXQ9MCZtYXhfaWRsZV9jb25uZWN0aW9uX2xpZmV0aW1lPTAmcG9vbF90aW1lb3V0PTAmc2luZ2xlX3VzZV9jb25uZWN0aW9ucz10cnVlJnNvY2tldF90aW1lb3V0PTAifQ

ADVISORY_LOCK_ID=<32-bit-number>

# --- Pulumi S3 Backend Configuration ---
# Used by Pulumi Automation API to store state in S3-compatible storage (Garage, MinIO, etc.)
PULUMI_BACKEND_URL=s3://pulumi-state?endpoint=http://localhost:3900&disableSSL=true&s3ForcePathStyle=true&region=garage
AWS_ACCESS_KEY_ID=<your-s3-access-key>
AWS_SECRET_ACCESS_KEY=<your-s3-secret-key>
AWS_REGION=garage