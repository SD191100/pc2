# ===========================================
# PC2 Docker Compose Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# --- Server Port ---
PORT=8000

# --- Pulumi Secrets ---
PULUMI_CONFIG_PASSPHRASE=password

# --- PostgreSQL Database ---
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=compute_db
POSTGRES_PORT=5432

# --- Garage S3 Storage ---
GARAGE_API_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_ADMIN_PORT=3903
# These will be generated after garage init - see README
AWS_ACCESS_KEY_ID=<your-garage-access-key>
AWS_SECRET_ACCESS_KEY=<your-garage-secret-key>
AWS_REGION=garage

# --- PC2 API Settings ---
PC2_API_PORT=8000
NODE_ENV=development
LOG_LEVEL=debug
ADVISORY_LOCK_ID=9876543210
# CORS - use * for all origins or specify like http://localhost:3000
CORS_ORIGIN=*

# --- PC2 Web Settings ---
PC2_WEB_PORT=3000
NEXT_PUBLIC_VALID_TOKEN=MOCK_TOKEN_ABC

# --- Proxmox Provider Credentials ---
PROXMOX_ENDPOINT=https://<proxmox-endpoint>:8006
PROXMOX_API_TOKEN_ID=root@pam!<token-name>
PROXMOX_API_TOKEN_SECRET=<token-secret>
PROXMOX_NODE=<node-name>
PROXMOX_TEMPLATE_VM_ID=9000
PROXMOX_DATASTORE_ID=<datastore>
PROXMOX_SSH_USERNAME=root
PROXMOX_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
PROXMOX_SSL_VERIFY=false
