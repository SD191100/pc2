// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VmStatus {
  pending
  creating
  completed
  failed
}

enum taskStatus {
  pending
  inProgress
  completed
  failed
}

model VM {
  id String @id @unique @default(uuid()) // Primary key
  vmId String @unique
  name String
  cpu Int
  memory Int
  storage Int
  ioAddress String?
  gateway String?
  username String?
  password String?
  templateId String?
  stackName String @unique
  owner String?
  status VmStatus @default(pending) 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id String @id @unique @default(uuid()) // Primary Key
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
